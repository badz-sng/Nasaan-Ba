{
  "expo": {
    "name": "Nasaan ba?",
    "slug": "nasaan-ba",
    "scheme": "nasaanba",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nasaanba.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Face ID is used to protect your inventory."
      }
    },
    "android": {
      "package": "com.nasaanba.app",
      "permissions": ["USE_BIOMETRIC", "USE_FINGERPRINT", "SCHEDULE_EXACT_ALARM", "POST_NOTIFICATIONS"]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Photo access is needed to add an image to an item."
        }
      ]
    ],
    "extra": {
      "router": {}
    }
  }
}
